+private fun ModuleBottomSheetContent(
+    viewModel: ModuleViewModel,
+    uiState: ModuleUiState,
+    prefs: AppPreferencesRepository
+) {
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(bottom = 24.dp)
+    ) {
+        // 标题
