+# Reporting Security Issues
+
+The KernelSU team and community take security bugs in KernelSU seriously. We appreciate your efforts to responsibly disclose your findings, and will make every effort to acknowledge your contributions.
+
+To report a security issue, please use the GitHub Security Advisory ["Report a Vulnerability"](https://github.com/tiann/KernelSU/security/advisories/new) tab, or you can mailto [weishu](mailto:twsxtd@gmail.com) directly.
+
+The KernelSU team will send a response indicating the next steps in handling your report. After the initial reply to your report, the security team will keep you informed of the progress towards a fix and full announcement, and may ask for additional information or guidance.
diff -ruN '--exclude=.github' baseline/R1_original/drivers/kernelsu/build-all.sh kernel_xiaomi_lavender-R1/drivers/kernelsu/build-all.sh
--- baseline/R1_original/drivers/kernelsu/build-all.sh	1970-01-01 00:00:00.000000000 +0000
+++ kernel_xiaomi_lavender-R1/drivers/kernelsu/build-all.sh	2026-07-15 04:04:12.966122011 +0000
@@ -0,0 +1,36 @@
+#!/bin/bash
+set -e
+
+if [ -z "$1" ]; then
+    KMIS="android12-5.10 android13-5.10 android13-5.15 android14-5.15 android14-6.1 android15-6.6 android16-6.12"
+else
+    KMIS=$1
+fi
+
+cd "$(dirname "$(readlink -f "$0")")/.."
+
+# Some patch is required to use separate build dir when building for android16-6.12, see:
+# https://github.com/5ec1cff/ddk#local-%E6%A8%A1%E5%BC%8F%E6%9E%84%E5%BB%BA%E9%80%82%E7%94%A8%E4%BA%8E%E5%A4%9A%E4%B8%AA-target-%E7%89%88%E6%9C%AC%E7%9A%84%E5%86%85%E6%A0%B8%E6%A8%A1%E5%9D%97
+
+mv .ddk-version .ddk-version.bak 2> /dev/null || true
+
+for kmi in $KMIS; do
+    echo "========== Building $kmi =========="
+    ODIR="$(realpath .)/out/$kmi"
+    if ddk build "$kmi" "ODIR=$ODIR" -e CONFIG_KSU=m -e CONFIG_KSU_TRACEPOINT_HOOK=y -e CONFIG_KSU_MULTI_MANAGER_SUPPORT=y -- -C kernel; then
+        if [ -f "$ODIR/kernelsu.ko" ]; then
+            cp "$ODIR/kernelsu.ko" "kernel/kernelsu-${kmi}.ko"
+            llvm-strip -d "kernel/kernelsu-${kmi}.ko"
+            echo "✓ Built kernelsu-${kmi}.ko"
+        fi
+    else
+        echo "✗ Build failed for $kmi"
+    fi
+    echo ""
+done
+
+mv .ddk-version.bak .ddk-version 2> /dev/null || true
+
+echo "========== Final output =========="
+cd kernel
+ls -l kernelsu-*.ko
