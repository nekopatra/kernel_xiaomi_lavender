diff -ruN '--exclude=.github' baseline/R1_original/drivers/kernelsu/Makefile kernel_xiaomi_lavender-R1/drivers/kernelsu/Makefile
--- baseline/R1_original/drivers/kernelsu/Makefile	1970-01-01 00:00:00.000000000 +0000
+++ kernel_xiaomi_lavender-R1/drivers/kernelsu/Makefile	2026-07-15 04:04:12.965583813 +0000
@@ -0,0 +1,29 @@
+KDIR := $(KDIR)
+MDIR := $(realpath $(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
+ODIR := $(MDIR)
+
+ifneq ($(KDIR),)
+$(info -- KDIR: $(KDIR))
+$(info -- MDIR: $(MDIR))
+$(info -- OUTPUT DIR: $(ODIR))
+endif
+
+.PHONY: all compdb clean format check-format
+
+all: check_symbol
+	make -C $(KDIR) M=$(ODIR) src=$(MDIR) modules compile_commands.json -j$(shell nproc)
+	./check_symbol $(ODIR)/kernelsu.ko $(KDIR)/vmlinux
+
+compdb:
+	python3 $(MDIR)/.vscode/generate_compdb.py -O $(ODIR) $(MDIR)
+clean:
+	make -C $(KDIR) M=$(ODIR) src=$(MDIR) clean
+	rm check_symbol
+check_symbol: tools/check_symbol.c
+	$(CC) tools/check_symbol.c -o check_symbol
+format:
+	find . \( -name "*.c" -o -name "*.h" \) -print0 | xargs -0 clang-format -i
+check-format:
+	find . \( -name "*.c" -o -name "*.h" \) -print0 | xargs -0 clang-format --dry-run --Werror
+
+# Keep a new line here!! Because someone may append config
