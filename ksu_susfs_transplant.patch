+                            }
+                        }
+
+                        AnimatedVisibility(
+                            visible = mode != Mode.Default,
+                            enter = fadeIn() + expandVertically(),
+                            exit = fadeOut() + shrinkVertically()
+                        ) {
+                            Crossfade(
+                                targetState = mode,
+                                label = "ProfileMode"
+                            ) { currentMode ->
+                                when (currentMode) {
+                                    Mode.Template -> {
+                                        SegmentedColumn {
+                                            item {
