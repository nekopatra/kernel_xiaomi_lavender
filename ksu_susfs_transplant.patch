+        }
+
+        // Create resetprop -> ksud symlink (resetprop is now built into ksud)
+        let resetprop_link = RESETPROP_PATH;
+        let _ = std::fs::remove_file(resetprop_link);
+        std::os::unix::fs::symlink("/data/adb/ksud", resetprop_link)?;
+
+        Ok(())
+    }
