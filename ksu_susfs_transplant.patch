+                                callback(true)
+                                return
+                            }
+
+                            lifecycleScope.launch {
+                                mutex.withLock {
+                                    suspendCancellableCoroutine { continuation ->
+                                        currentCallback = { result ->
+                                            callback(result.any { it.value })
+                                            continuation.resume(Unit)
