--- baseline/R1_original/drivers/kernelsu/manager/build.gradle.kts	1970-01-01 00:00:00.000000000 +0000
+++ kernel_xiaomi_lavender-R1/drivers/kernelsu/manager/build.gradle.kts	2026-07-15 04:04:13.113499506 +0000
@@ -0,0 +1,27 @@
+plugins {
+    alias(libs.plugins.agp.app) apply false
+    alias(libs.plugins.kotlin) apply false
+    alias(libs.plugins.compose.compiler) apply false
+}
+
+val androidMinSdkVersion by extra(26)
+val androidTargetSdkVersion by extra(37)
+val androidCompileSdkVersion by extra(37)
+val androidBuildToolsVersion by extra("36.1.0")
+val androidCompileNdkVersion by extra(libs.versions.ndk.get())
+val androidSourceCompatibility by extra(JavaVersion.VERSION_21)
+val androidTargetCompatibility by extra(JavaVersion.VERSION_21)
+val managerVersionCode by extra(30000 + getGitCommitCount() + 700)
+val managerVersionName by extra(getGitDescribe())
+
+fun getGitCommitCount(): Int {
+    return providers.exec {
+        commandLine("git", "rev-list", "--count", "HEAD")
+    }.standardOutput.asText.get().trim().toInt()
+}
+
+fun getGitDescribe(): String {
+    return providers.exec {
+        commandLine("git", "describe", "--tags", "--always", "--abbrev=0")
+    }.standardOutput.asText.get().trim()
+}
