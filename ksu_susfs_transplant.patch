+++ kernel_xiaomi_lavender-R1/drivers/kernelsu/feature/dynamic_manager.c	2026-07-15 04:04:12.970751039 +0000
@@ -0,0 +1,113 @@
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/gfp.h>
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/version.h>
