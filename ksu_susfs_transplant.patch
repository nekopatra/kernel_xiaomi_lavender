+            } catch (_: Exception) {
+                null
+            }
+            
+            val file = if (shell != null) {
+                SuFile(path).apply { setShell(shell) }
+            } else {
+                File(path)
+            }
+            
+            file.exists() && file.isDirectory
+        } catch (_: Exception) {
+            false
+        }
+    }
