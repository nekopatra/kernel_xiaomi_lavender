+    fun fromLegacyName(name: String): Color = when (name.lowercase()) {
+        "green" -> Color(0xFF4C662B)
+        "purple" -> Color(0xFF7C4E7E)
+        "orange" -> Color(0xFF8B4F24)
+        "pink" -> Color(0xFF8C4A60)
+        "gray" -> Color(0xFF5B5C5C)
