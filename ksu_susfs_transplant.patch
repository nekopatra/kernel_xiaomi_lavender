diff -ruN '--exclude=.github' baseline/R1_original/drivers/kernelsu/manager/app/src/main/cpp/uapi/supercall.h kernel_xiaomi_lavender-R1/drivers/kernelsu/manager/app/src/main/cpp/uapi/supercall.h
