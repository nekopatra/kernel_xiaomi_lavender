+                when (choice) {
+                    0 -> launchApp(appGroup.mainApp.packageName)
+                    1 -> forceStopApp(appGroup.mainApp.packageName)
+                    2 -> restartApp(appGroup.mainApp.packageName)
+                    else -> throw IllegalStateException("Illegal choice: $choice")
