+}
+
+@Composable
+internal fun rememberAnimatedShape(
+    currentShape: CornerBasedShape,
+    animationSpec: FiniteAnimationSpec<Float>,
+): Shape {
+    val state =
+        remember(animationSpec) {
+            AnimatedCornerBasedShapeState(shape = currentShape, spec = animationSpec)
+        }
