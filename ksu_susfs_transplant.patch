+                if (ThemeConfig.isEnableBlur)
+                    Color.Transparent
+                else
+                    MaterialTheme.colorScheme.surfaceContainer.copy(CardConfig.cardAlpha)
+            )
+            .then(
+                if (haze) {
+                    Modifier.blurEffect(
+                    )
+                } else Modifier
+            )
+    ) {
+        LargeFlexibleTopAppBar(
+            scrollBehavior = scrollBehavior,
+            title = {
+                Text(
+                    text = title
+                )
+            },
+            navigationIcon = {
+                if (onBackClick != null) {
+                    AppBackButton(
+                        onClick = {
+                            onBackClick.invoke()
+                        }
+                    )
